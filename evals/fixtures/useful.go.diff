+package store
+
+// Open returns a Store backed by path. It creates the file when missing.
+func Open(path string) (*Store, error) {
+	// O_SYNC: the WAL relies on each write hitting disk before the ack.
+	f, err := os.OpenFile(path, os.O_RDWR|os.O_CREATE|os.O_SYNC, 0o600)
+	if err != nil {
+		return nil, err
+	}
+	return &Store{f: f}, nil
+}
