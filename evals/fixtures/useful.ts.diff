@@ -0,0 +1,16 @@
+// Debounce at 300ms: the search API rejects more than 3 calls per second.
+export const SEARCH_DEBOUNCE_MS = 300;
+
+export function parseDate(s: string): Date {
+  // Safari rejects "YYYY-MM-DD HH:mm"; the T separator is required.
+  return new Date(s.replace(" ", "T"));
+}
+
+// Keep in sync with STATUS_LABELS in server/status.go.
+export const STATUS = ["open", "closed"] as const;
+
+// eslint-disable-next-line @typescript-eslint/no-explicit-any -- third-party payload has no schema
+export function fromPayload(p: any): Item { return p as Item; }
+
+// TODO: remove once Node 18 is out of support; fetch is global in 20+.
+import fetch from "node-fetch";
